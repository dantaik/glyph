{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xueni",
  "version": "0.1.0",
  "identifier": "xyz.xueni.desktop",
  "build": {
    "beforeDevCommand": "cd ../webapp && npm run dev",
    "beforeBuildCommand": "cd ../webapp && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../webapp/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xueni",
        "width": 1100,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "category": "Productivity",
    "shortDescription": "A multi-author journal stored in Ethereum calldata",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
